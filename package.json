{
  "name": "chess-game-web-based",
  "version": "1.0.0",
  "description": "Complete Chess Game Application",
  "scripts": {
    "start": "npm run server",
    "server": "cd Backend && npm start",
    "client": "cd Frontend && npm start",
    "dev": "npm run server",
    "both": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && cd Frontend && npm install && cd ../Backend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chess.js": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "crypto": "^1.0.1",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "nodemailer": "^7.0.11",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}
